{
  "framework": null,
  "installCommand": null,
  "buildCommand": "node tools/build-site.js",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/wp-admin/:path*", "destination": "/", "permanent": false },
    { "source": "/wp-login.php", "destination": "/", "permanent": false },
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/projects.html", "destination": "/projects", "permanent": true },
    { "source": "/light", "destination": "/", "permanent": true },
    { "source": "/light/:path*", "destination": "/", "permanent": true },
    { "source": "/dark/index.html", "destination": "/dark", "permanent": true },
    { "source": "/dark/projects.html", "destination": "/dark/projects", "permanent": true }
  ]
}
